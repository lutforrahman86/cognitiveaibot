# Server
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (use a connection string or individual vars)
DATABASE_URL=postgresql://localhost:5432/cognitiveaibot

# JWT - use a strong random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# OAuth - create apps at https://console.cloud.google.com and https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI provider keys. Keys stay on the server and are never sent to a client.
# Every model is called directly at its own provider, never through an
# aggregator or reseller. A provider's models are greyed out until its key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: point a provider at a different endpoint of that same provider.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: cap on reply length, in tokens (default 8192). Thinking models
# count their reasoning toward this.
# GATEWAY_MAX_OUTPUT_TOKENS=8192

# Credits. Every reply holds its worst-case cost first, then charges what it used.
# What one credit is worth in USD, for cost figures (default 0.01). Model credit
# prices live in the database; see src/db/data/model-catalog-*.json.
# CREDIT_USD_VALUE=0.01

# Payments (Stripe). Checkout is off until STRIPE_SECRET_KEY is set; use a test
# key (sk_test_…) for development. Credits are granted only by Stripe's signed
# webhook: point a webhook at POST /api/billing/webhook and put its signing
# secret here. Locally: `stripe listen --forward-to localhost:3000/api/billing/webhook`
# prints a whsec_… to use. Events needed: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# refund.created, refund.updated.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# RevenueCat (App Store purchases in the mobile app). Point a RevenueCat webhook
# at POST /api/billing/revenuecat and set its Authorization header value here.
# Link each plan to its App Store product in the admin Plans tab.
# REVENUECAT_WEBHOOK_AUTH=

# Generated videos are kept on disk for download until they expire.
# MEDIA_STORAGE_DIR=./storage/media
# MEDIA_RETENTION_DAYS=7

# Redis, for the developer API's rate limits (requests and tokens per minute).
# Without it, counters live in each server process's memory: fine for one
# process in development, wrong with several.
# REDIS_URL=redis://localhost:6379

# Account emails (password reset, email confirmation). Any provider's SMTP
# works, e.g. smtps://user:pass@smtp.example.com:465. Without it, emails are
# printed to the server log instead of sent.
# SMTP_URL=
# EMAIL_FROM="CognitiveAI Bot <no-reply@example.com>"
# Trial credits are granted when a new user confirms their email.
# SIGNUP_TRIAL_CREDITS=50

# Behind a load balancer or reverse proxy, trust its X-Forwarded-For header so
# per-IP limits (sign-ups, password resets) see real client addresses.
# TRUST_PROXY=1
# Sign-ups and password-reset requests allowed per IP address per hour.
# SIGNUPS_PER_IP_PER_HOUR=5
# RESETS_PER_IP_PER_HOUR=10

# Safety. Prompts are checked with OpenAI's free moderation model (needs
# OPENAI_API_KEY); MODERATION=off disables it. Admins are alerted when an
# account spends more than this many credits in an hour, and alerts are
# emailed to ADMIN_ALERT_EMAIL if set. App users may send this many messages
# a minute.
# MODERATION=on
# SPEND_ALERT_CREDITS_PER_HOUR=500
# ADMIN_ALERT_EMAIL=
# APP_MESSAGES_PER_MINUTE=20

# Set to false to stop the server applying migrations on startup (run `npm run db:migrate` instead).
# DB_AUTO_MIGRATE=true

# Tests use DATABASE_URL with "_test" appended to the database name, unless this is set.
# TEST_DATABASE_URL=postgresql://localhost:5432/cognitiveaibot_test
